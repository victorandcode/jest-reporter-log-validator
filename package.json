{
  "name": "jest-reporter-log-validator",
  "version": "0.2.0",
  "description": "Jest reporter to validate log messages produced by tests",
  "keywords": [
    "jest",
    "unit-test",
    "reporter",
    "logging"
  ],
  "author": "Victor Cordova",
  "license": "MIT",
  "homepage": "https://github.com/victorandcode/jest-reporter-log-validator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorandcode/jest-reporter-log-validator.git"
  },
  "bugs": {
    "url": "https://github.com/victorandcode/jest-reporter-log-validator/issues"
  },
  "main": "src/reporter.js",
  "types": "src/reporter.d.ts",
  "exports": {
    ".": {
      "types": "./src/reporter.d.ts",
      "require": "./src/reporter.js",
      "default": "./src/reporter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/config.js",
    "src/reporter.d.ts",
    "src/reporter.js",
    "src/schema.js",
    "src/stdout.js",
    "src/utils.js",
    "src/validate-logs.js"
  ],
  "engines": {
    "node": ">=18.14.0"
  },
  "peerDependencies": {
    "jest": ">=26 <31"
  },
  "dependencies": {
    "table": "^6.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "jest": "^30.5.2"
  },
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepublishOnly": "npm run check && npm test",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "packageManager": "pnpm@12.21.0"
}
